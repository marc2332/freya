---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Support and contracting - Freya"
  description="Paid Freya support, contracting, and sponsorship."
  url="/support"
>
  <section class="max-w-4xl mx-auto pb-6 lg:pb-10" id="paid-services">
    <h2 class="text-3xl font-bold text-white mb-4">Collaborating</h2>
    <p class="text-stone-400 leading-relaxed max-w-2xl">
      If you seek commercial support for your app, send me an email at{" "}
      <a class="text-custom-purple hover:text-white hover:underline" href="mailto:marc@mespin.me">marc@mespin.me</a>.
    </p>
  </section>

  <section class="max-w-4xl mx-auto border-t border-stone-800/50 py-8 lg:py-12" id="sponsoring">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-white mb-4">Sponsoring</h2>
      <p class="text-stone-400 leading-relaxed mb-6">
        Freya is open source and maintained in public. Sponsoring helps fund the development.
      </p>
      <a
        class="inline-block rounded-lg bg-pink-300 px-6 py-3 text-black font-semibold hover:bg-pink-400 transition-colors"
        href="https://github.com/sponsors/marc2332"
      >
        Sponsor on GitHub
      </a>
    </div>
  </section>
</Layout>
