---
import { readFileSync } from "node:fs";
import { Code } from "astro:components";
import "@fontsource/jetbrains-mono/400.css";
import Layout from "../layouts/Layout.astro";
import FeatureSection from "../components/FeatureSection.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import FeatureIcon from "../components/FeatureIcon.astro";

const sponsors = JSON.parse(readFileSync("public/sponsors.json", "utf8"));
const usedBy = [
  {
    name: "Polyfrost",
    href: "https://polyfrost.org",
    logo: "/polyfrost-logo.svg",
  },
  {
    name: "Zerac",
    href: "https://www.zerac.com/",
    logo: "/zerac-logo-text.svg",
    icon: "/zerac-logo-icon.svg",
    background: "#212d34",
  },
  { name: "Myself", href: "https://github.com/marc2332" },
  { name: "Community", href: "https://github.com/marc2332/freya" },
];

const EXAMPLE_CODE = `
fn app() -> impl IntoElement {
    let mut count = use_state(|| 4);

    let counter = rect()
        .width(Size::fill())
        .height(Size::percent(50.))
        .center()
        .color((255, 255, 255))
        .background((15, 163, 242))
        .font_weight(FontWeight::BOLD)
        .font_size(75.)
        .child(count.read().to_string());

    let actions = rect()
        .horizontal()
        .center()
        .spacing(8.0)
        .child(
            Button::new()
                .on_press(move |_| *count.write() += 1)
                .child("Increase"),
        )
        .child(
            Button::new()
                .on_press(move |_| *count.write() -= 1)
                .child("Decrease"),
        );

    rect().child(counter).child(actions)
}
`.trim();

const docsUrl = "https://docs.rs/freya/latest/freya";
const capabilities = [
  {
    title: "Rendering",
    icon: "gpu",
    description:
      "Skia rendering with Vulkan, OpenGL, Metal, and software backends. GPU support and fallback depend on the platform.",
    href: `${docsUrl}/_docs/platforms/index.html`,
    label: "Rendering backends",
  },
  {
    title: "Async runtime",
    icon: "async",
    description:
      "Spawn tasks tied to a component, a window, or the whole app. Integrate Tokio when you need it.",
    href: `${docsUrl}/_docs/_async/index.html`,
    label: "Async guide",
  },
  {
    title: "State & caching",
    icon: "cache",
    description:
      "Reactive state, shared stores, and async queries with caching and invalidation through Freya Query and Radio.",
    href: `${docsUrl}/_docs/state_management/index.html`,
    label: "State management",
  },
  {
    title: "Routing",
    icon: "route",
    description:
      "Typed routes, nested views, and navigation history, without putting everything in one component.",
    href: "https://docs.rs/freya-router/latest/freya_router/",
    label: "Router docs",
  },
  {
    title: "Multi-window & tray",
    icon: "windows",
    description:
      "Open more windows, share state between them, and keep desktop actions in the system tray.",
    href: "https://github.com/marc2332/freya/tree/main/examples",
    label: "Desktop examples",
  },
  {
    title: "Terminal",
    icon: "terminal",
    description:
      "Embed a terminal with PTY support, keyboard and mouse input, and clipboard integration.",
    href: "https://docs.rs/freya-terminal/latest/freya_terminal/",
    label: "Terminal docs",
  },
  {
    title: "HTML & Markdown",
    icon: "html",
    description:
      "Render HTML and CSS with Blitz, or display Markdown documents inside your app.",
    href: "https://github.com/marc2332/freya/tree/main/examples/feature_html",
    label: "HTML example",
  },
  {
    title: "Camera & video",
    icon: "camera",
    description:
      "Capture webcam frames or play video with audio using optional media integrations.",
    href: "https://docs.rs/freya-video/latest/freya_video/",
    label: "Video docs",
  },
  {
    title: "Components & animation",
    icon: "components",
    description:
      "Buttons, inputs, calendars, virtual lists, and more. Animate sizes, positions, and colors.",
    href: "/demo/",
    label: "Try the components",
  },
  {
    title: "Text & code editing",
    icon: "editor",
    description:
      "Text selection, cursor control, rich editing, and a code editor with tree-sitter highlighting.",
    href: "https://docs.rs/freya-code-editor/latest/freya_code_editor/",
    label: "Code editor docs",
  },
  {
    title: "Testing & devtools",
    icon: "testing",
    description:
      "Test interactions headlessly. Inspect the component tree, layout, and performance as you build.",
    href: "https://docs.rs/freya-testing/latest/freya_testing/",
    label: "Testing docs",
  },
  {
    title: "Docs & examples",
    icon: "docs",
    description:
      "API references, guides, and runnable examples, from a counter to multi-window apps.",
    href: `${docsUrl}/`,
    label: "Read the docs",
  },
  {
    title: "AI-ready",
    icon: "ai",
    description:
      "Give your coding assistant the Freya skill or llms.txt so it can work with the right APIs.",
    href: `${docsUrl}/_docs/ai/index.html`,
    label: "Set up your assistant",
  },
  {
    title: "Charts & plotting",
    icon: "charts",
    description:
      "Build charts, graphs, and interactive data visualizations with the Plotters integration.",
    href: "https://docs.rs/freya-plotters-backend/latest/freya_plotters_backend/",
    label: "Plotters docs",
  },
  {
    title: "Icons",
    icon: "icons",
    description:
      "Use Lucide icons in your components, with control over their size and color.",
    href: "https://docs.rs/freya-icons/latest/freya_icons/",
    label: "Icon docs",
  },
  {
    title: "Internationalization",
    icon: "language",
    description:
      "Translate your app with Fluent and switch languages while it is running.",
    href: "https://docs.rs/freya-i18n/latest/freya_i18n/",
    label: "Internationalization docs",
  },
  {
    title: "Accessibility",
    icon: "accessibility",
    description:
      "AccessKit integration, accessible roles and labels, keyboard navigation, and focus management.",
    href: "https://github.com/marc2332/freya/blob/main/examples/accessibility.rs",
    label: "Accessibility example",
  },
  {
    title: "Theming",
    icon: "palette",
    description:
      "Share colors and typography across components, create custom themes, and switch them at runtime.",
    href: "https://github.com/marc2332/freya/blob/main/examples/theme_definition.rs",
    label: "Custom theme example",
  },
  {
    title: "Shaders & custom drawing",
    icon: "drawing",
    description:
      "Write Skia shaders, draw on the canvas, and add gradients, shadows, and blur to your UI.",
    href: "https://github.com/marc2332/freya/blob/main/examples/style_shader_fill.rs",
    label: "Shader example",
  },
  {
    title: "Docking & resizable panels",
    icon: "panels",
    description:
      "Build tabbed workspaces with dockable panels, split layouts, and draggable resize handles.",
    href: "https://github.com/marc2332/freya/blob/main/examples/component_docking.rs",
    label: "Docking example",
  },
  {
    title: "Drag & drop",
    icon: "drag",
    description:
      "Move typed data between drag sources and drop targets, or handle files dropped into your app.",
    href: "https://github.com/marc2332/freya/blob/main/examples/component_drag_drop.rs",
    label: "Drag and drop example",
  },
  {
    title: "Material Design",
    icon: "design",
    description:
      "Add Material Design components and effects, including ripples, to your app.",
    href: "https://docs.rs/freya-material-design/latest/freya_material_design/",
    label: "Material Design docs",
  },
] as const;

const features = [
  {
    title: "Built-in components",
    description:
      "Buttons, sliders, calendars, color pickers, and virtual lists. Try them in the gallery.",
    mediaUrl: "/freya-gallery.png",
    mediaType: "image" as const,
  },
  {
    title: "Animations",
    description:
      "Animate colors, sizes, and positions with control over timing, easing, and sequences.",
    mediaUrl: "/freya-animations.mp4",
    mediaType: "video" as const,
  },
  {
    title: "Rich text editing",
    description:
      "Selection, keyboard shortcuts, formatting, and virtualization for more than a basic input field.",
    mediaUrl: "/freya-text-editing.png",
    mediaType: "image" as const,
  },
  {
    title: "Code editor",
    description:
      "Rope-based text editing and tree-sitter syntax highlighting in a reusable component.",
    mediaUrl: "/freya-code-editor.png",
    mediaType: "image" as const,
  },
  {
    title: "Charts & plotting",
    description:
      "Draw charts and interactive visualizations with the Plotters integration.",
    mediaUrl:
      "https://github.com/user-attachments/assets/236285ea-a2c2-4739-a59d-029a7c3ef601",
    mediaType: "video" as const,
  },
  {
    title: "Terminal emulation",
    description:
      "A terminal inside your app, with PTY support for shells and command-line tools.",
    mediaUrl:
      "https://github.com/user-attachments/assets/12322dad-cb89-450b-bd8f-c9d5fbe2d45a",
    mediaType: "image" as const,
  },
  {
    title: "Developer tools",
    description:
      "Inspect the component tree and its properties while your app is running.",
    mediaUrl:
      "https://github.com/user-attachments/assets/906fdbec-7b3c-4dc4-a420-95fdf852b1e4",
    mediaType: "image" as const,
  },
];
---

<Layout
  title="Freya - GUI Library for Rust"
  description="Build GUI apps in Rust with Skia rendering, reactive state, an async runtime, and a full set of components. Explore platforms, integrations, and examples."
>
  <section class="hero">
  <div class="flex flex-col items-center gap-6 text-center">
    <div class="min-w-0 max-w-3xl">
      <h1 class="text-[2.025rem] lg:text-[2.7rem] font-bold leading-tight">Build your next app with Rust</h1>
      <p class="mt-4 text-stone-300 leading-relaxed [text-wrap:balance]">
        Build <strong>cross-platform</strong>, <strong>performant</strong>, <strong>accessible</strong> and <strong>unique</strong> apps with 🦀 Rust.
      </p>
    </div>
    <div class="shrink-0">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          class="block text-center px-6 py-3 text-lg bg-custom-purple rounded-[26px] text-white hover:bg-custom-purple-dark transition-colors delay-[10]"
          href="https://docs.rs/freya/latest/freya/"
          >Get Started</a
        >
        <a
          class="block text-center px-6 py-3 text-lg bg-white/10 backdrop-blur-md rounded-[26px] text-white hover:bg-white/15 transition-colors delay-[10]"
          href="/demo/">Try it</a
        >
      </div>
    </div>
  </div>

    <div class="hero-example">
    <div class="example-code"><Code code={EXAMPLE_CODE} lang="rs" /></div>
    <div class="hero-preview">
      <video muted autoplay playsinline loop width="502" height="484" aria-label="Freya counter app demo" class="w-full rounded-lg">
        <source src="/demo.webm" type="video/webm" />
      </video>
      <div class="flex flex-wrap gap-4 mt-4 text-sm text-white">
        <a href="/demo/" class="text-purple-300">Try it in your browser ↗</a>
        <a href="https://github.com/marc2332/freya#trying-it-out-">Run locally ↗</a>
        <a href="https://github.com/marc2332/freya/tree/main/examples">More examples ↗</a>
      </div>
    </div>
    </div>
  </section>

  <section aria-labelledby="capabilities-heading" class="py-8">
    <div class="section-heading">
      <div>
        <h2 id="capabilities-heading" class="text-2xl font-bold">Features</h2>
      </div>
      <a href={`${docsUrl}/`} class="text-sm text-white">Docs ↗</a>
    </div>
    <div class="capability-grid">
      <a href={`${docsUrl}/_docs/platforms/index.html`} class="capability-card" aria-label="Cross-platform: platform details">
        <h3><FeatureIcon name="globe" class="feature-icon" />Cross-platform<span aria-hidden="true">↗</span></h3>
        <ul class="platforms">
          {(["Linux", "Windows", "macOS", "Android", "Web"] as const).map((platform) => (
            <li class="platform">
              <PlatformIcon name={platform} />
              <span>{platform}</span>
            </li>
          ))}
        </ul>
      </a>
      {capabilities.map((capability) => (
        <a href={capability.href} class="capability-card" aria-label={`${capability.title}: ${capability.label}`}>
          <h3><FeatureIcon name={capability.icon} class="feature-icon" />{capability.title}<span aria-hidden="true">↗</span></h3>
          <p>{capability.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-8 border-y border-stone-800/30">
    <div class="max-w-4xl grid gap-8">
      <div>
        <h2 class="text-xl lg:text-2xl font-bold text-stone-200 mb-5">Sponsors</h2>
        <div class="flex flex-wrap gap-3 min-h-12">
          {
            sponsors.length > 0 ? sponsors.map((sponsor) => (
              <a href={sponsor.href} title={sponsor.name}>
                <img
                  class="h-12 w-12 rounded-full border border-stone-800/60 hover:border-custom-purple transition-colors"
                  src={sponsor.avatar}
                  alt={sponsor.name}
                  loading="lazy"
                />
              </a>
            )) : <p class="text-stone-400">Support Freya on GitHub Sponsors.</p>
          }
        </div>
      </div>
      <div>
        <h2 class="text-xl lg:text-2xl font-bold text-stone-200 mb-5">Used by</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {
            usedBy.map((project) => (
              <a
                class:list={[
                  "flex min-h-20 items-center justify-center rounded-lg border border-stone-800/60 px-4 text-center transition-colors hover:border-custom-purple",
                  project.logo ? "bg-white" : "bg-custom-dark-gray text-stone-400 hover:text-white",
                ]}
                href={project.href}
                style={project.background ? { backgroundColor: project.background } : undefined}
              >
                {project.logo ? (
                  <span class="flex items-center justify-center gap-2">
                    {project.icon && (
                      <img class="h-9 w-auto" src={project.icon} alt="" loading="lazy" />
                    )}
                    <img
                      class:list={[
                        "max-w-full",
                        project.icon ? "h-8 w-auto min-w-0" : "max-h-10",
                      ]}
                      src={project.logo}
                      alt={project.name}
                      loading="lazy"
                    />
                  </span>
                ) : project.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="gallery-heading" class="py-10">
    <div class="section-heading">
      <div>
        <h2 id="gallery-heading" class="text-2xl font-bold">See what you can build</h2>
      </div>
    </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      features.map((feature) => (
        <FeatureSection
          title={feature.title}
          description={feature.description}
          mediaUrl={feature.mediaUrl}
          mediaType={feature.mediaType}
          compact
        />
      ))
    }
  </div>

  </section>

  <div class="text-center py-12 border-t border-stone-800/30">
    <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready to get started?</h2>
    <p class="text-stone-400 text-lg mb-8 max-w-xl mx-auto">
      Build cross-platform, native GUI applications with Rust and Skia.
    </p>
    <div class="flex flex-wrap justify-center gap-2">
      <a
        class="px-6 py-2 bg-custom-purple rounded-[26px] text-white hover:bg-custom-purple-dark transition-colors delay-[10]"
        href="https://docs.rs/freya/latest/freya/"
        >Get Started</a
      >
      <a
        class="px-6 py-2 bg-orange-300 rounded-[26px] text-black hover:bg-orange-400 transition-colors delay-[10]"
        href="https://github.com/marc2332/freya">Source Code</a
      >
      <a
        class="px-6 py-2 bg-pink-300 rounded-[26px] text-black hover:bg-pink-400 transition-colors delay-[10]"
        href="/support/">Support</a
      >
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0;
  }

  .hero-preview {
    min-width: 0;
    width: 100%;
    max-width: 440px;
    justify-self: center;
  }

  .hero-preview video {
    display: block;
    width: 100%;
    height: auto;
  }

  .platforms, .platform {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .platforms {
    gap: 0.75rem 1rem;
    border: 0;
    padding: 0;
    margin-top: 0.75rem;
    color: #a8a29e;
  }

  .platform {
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .platform :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
  }

  .capability-grid {
    display: grid;
    gap: 0.75rem;
  }

  .capability-card {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid #29292c;
    border-radius: 0.75rem;
    background: #131315;
    transition: border-color 150ms;
  }

  .capability-card:hover {
    border-color: #444448;
  }

  .capability-card p {
    font-size: 0.85rem;
    line-height: 1.65;
    color: #a8a29e;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .capability-card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .capability-card h3 span {
    margin-left: auto;
    color: #78716c;
  }

  .capability-card :global(.feature-icon) {
    flex-shrink: 0;
    color: #a8b6c7;
  }

  .hero-example {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem 0.75rem;
    border: 1px solid #29292c;
    border-radius: 1rem;
    background: #131315;
  }

  .example-code {
    min-width: 0;
    max-width: 100%;
    width: 100%;
    justify-self: center;
    overflow-x: auto;
    font-size: 0.75rem;
  }

  .example-code :global(pre),
  .example-code :global(code) {
    font-family: "JetBrains Mono", monospace;
  }

  .example-code :global(pre) {
    padding: 4px;
  }

  a:hover:not(.capability-card):not([class*="bg-"]),
  .capability-card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:focus-visible {
    outline: 2px solid #7dd3fc;
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .hero {
      gap: 3rem;
      padding: 3.5rem 0 2rem;
    }

    .hero-example {
      padding: calc(1.25rem + 24px) calc(1.25rem + 4px);
    }

    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .capability-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-example {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .example-code {
      width: max-content;
    }
  }
</style>
