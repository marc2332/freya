---
import { readFileSync } from "node:fs";
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import FeatureSection from "../components/FeatureSection.astro";
import PlatformIcon from "../components/PlatformIcon.astro";

const readme = readFileSync("../README.md", "utf8");
const sponsors = [...readme.matchAll(/<a href="([^"]+)"><img src="([^"]+)"[^>]*alt="([^"]*)"/g)].map(
  ([, href, avatar, name]) => ({
    href: href.replaceAll("&#x2F;", "/"),
    avatar: avatar.replaceAll("&#x2F;", "/"),
    name: name || "Freya sponsor",
  }),
);
const usedBy = [
  { name: "Polyfrost", href: "https://polyfrost.org", logo: "/polyfrost-logo.svg" },
  { name: "Myself", href: "https://github.com/marc2332" },
  { name: "Other community members", href: "https://github.com/marc2332/freya" },
];

const EXAMPLE_CODE = `
fn app() -> impl IntoElement {
    let mut count = use_state(|| 4);

    let counter = rect()
        .width(Size::fill())
        .height(Size::percent(50.))
        .center()
        .color((255, 255, 255))
        .background((15, 163, 242))
        .font_weight(FontWeight::BOLD)
        .font_size(75.)
        .child(count.read().to_string());

    let actions = rect()
        .horizontal()
        .center()
        .spacing(8.0)
        .child(
            Button::new()
                .on_press(move |_| *count.write() += 1)
                .child("Increase"),
        )
        .child(
            Button::new()
                .on_press(move |_| *count.write() -= 1)
                .child("Decrease"),
        );

    rect().child(counter).child(actions)
}
`.trim();

const features = [
  {
    title: "Built-in Components",
    description:
      "Freya ships with a rich set of built-in components, from simple ones like Button, Switch, and Slider to more complex ones like VirtualScrollView, Calendar, and ColorPicker.",
    mediaUrl: "/freya-gallery.png",
    mediaType: "image" as const,
    actionUrl: "/demo",
    actionLabel: "See the demo",
  },
  {
    title: "Smooth Animations",
    description:
      "Create transitions for colors, sizes, positions, and other visual properties. The animation APIs give you full control over timing, easing functions, and animation sequences.",
    mediaUrl: "/freya-animations.mp4",
    mediaType: "video" as const,
  },
  {
    title: "Flexible Text editing",
    description:
      "Text editing capabilities that go beyond simple input fields. Build rich text editors with cursor management, text selection, keyboard shortcuts, custom formatting, and virtualization.",
    mediaUrl: "/freya-text-editing.png",
    mediaType: "image" as const,
  },
  {
    title: "Code Editor",
    description:
      "Create full-featured code editors with Rope-based text editing and tree-sitter syntax highlighting.",
    mediaUrl: "/freya-code-editor.png",
    mediaType: "image" as const,
  },
  {
    title: "Routing & Navigation",
    description:
      "Define routes, manage navigation state, and transition between different views. Build multi-page applications with a declarative routing API.",
    mediaUrl:
      "https://github.com/user-attachments/assets/1b3ed156-7e29-43f7-a11c-455ba0520223",
    mediaType: "image" as const,
  },
  {
    title: "Advanced Plotting & Charts",
    description:
      "Create charts, graphs, and interactive data visualizations directly within your application using the Plotters library integration.",
    mediaUrl:
      "https://github.com/user-attachments/assets/236285ea-a2c2-4739-a59d-029a7c3ef601",
    mediaType: "video" as const,
  },
  {
    title: "Terminal Emulation",
    description:
      "Full PTY (pseudo-terminal) support for building integrated terminal applications, SSH clients, or development tools right inside your app.",
    mediaUrl:
      "https://github.com/user-attachments/assets/12322dad-cb89-450b-bd8f-c9d5fbe2d45a",
    mediaType: "image" as const,
  },
  {
    title: "Developer Tools",
    description:
      "Examine the component tree in real-time with built-in developer tools. Inspect properties, debug layouts, and understand your UI structure as you build.",
    mediaUrl:
      "https://github.com/user-attachments/assets/906fdbec-7b3c-4dc4-a420-95fdf852b1e4",
    mediaType: "image" as const,
    wide: true,
  },
];
---

<Layout title="Freya - GUI Library for Rust">
  <div class="flex flex-col justify-start items-start pt-12 lg:pt-20 pb-8">
    <div class="max-w-2xl">
      <h1 class="text-3xl lg:text-4xl font-bold mb-4">Build GUI apps with Rust</h1>
      <p class="mb-5 text-stone-300">
        Build <strong>cross-platform</strong>, <strong>performant</strong>, <strong>accessible</strong> and <strong>unique</strong> apps with 🦀 <a
          href="https://www.rust-lang.org/"
          class="underline">Rust</a>.
      </p>
      <div class="flex flex-wrap gap-2">
        <a
          class="block text-center px-6 py-2 bg-sky-500 rounded-lg text-black hover:bg-sky-600 transition-colors delay-[10]"
          href="https://docs.rs/freya/latest/freya/"
          >Get Started</a
        >
        <a
          class="block text-center px-6 py-2 bg-orange-300 rounded-lg text-black hover:bg-orange-400 transition-colors delay-[10]"
          href="https://github.com/marc2332/freya">Source Code</a
        >
        <a
          class="block text-center px-6 py-2 bg-pink-300 rounded-lg text-black hover:bg-pink-400 transition-colors delay-[10]"
          href="/support">Support</a
        >
        <a
          class="block text-center px-6 py-2 bg-emerald-400 rounded-lg text-black hover:bg-emerald-500 transition-colors delay-[10]"
          href="/demo">Demo</a
        >
      </div>
    </div>
  </div>

  <div
    class="p-6 py-8 lg:w-content lg:flex gap-10 block justify-evenly items-center mx-auto text-black border border-stone-800 m-2 rounded-2xl bg-custom-dark-gray shadow-lg shadow-black/20"
  >
    <div class="text-xs hidden lg:block">
      <Code code={EXAMPLE_CODE} lang="rs" />
    </div>
    <div class="flex justify-center flex-col items-center gap-y-8">
      <video muted autoplay playsinline loop class="rounded-xl">
        <source src="/demo.webm" type="video/webm" />
      </video>
      <div class="flex gap-3">
        <a
          class="w-36 bg-custom-purple p-2 text-center rounded-lg text-white hover:bg-custom-purple-dark transition-colors delay-[10]"
          href="https://github.com/marc2332/freya#trying-it-out">Run locally</a
        >
        <a
          class="w-36 bg-white p-2 text-center rounded-lg text-black hover:bg-stone-200 transition-colors delay-[10]"
          href="https://github.com/marc2332/freya/tree/main/examples">More examples</a
        >
      </div>
    </div>
  </div>

  <section class="mt-12 lg:mt-16 py-8 lg:py-12 border-y border-stone-800/50">
    <div class="max-w-4xl grid gap-8">
      <div>
        <h2 class="text-xl lg:text-2xl font-bold text-stone-200 mb-5">Sponsors</h2>
        <div class="flex flex-wrap gap-3 min-h-12">
          {
            sponsors.length > 0 ? sponsors.map((sponsor) => (
              <a href={sponsor.href} title={sponsor.name}>
                <img
                  class="h-12 w-12 rounded-full border border-stone-700 hover:border-custom-purple transition-colors"
                  src={sponsor.avatar}
                  alt={sponsor.name}
                  loading="lazy"
                />
              </a>
            )) : <p class="text-stone-400">Support Freya on GitHub Sponsors.</p>
          }
        </div>
      </div>
      <div>
        <h2 class="text-xl lg:text-2xl font-bold text-stone-200 mb-5">Used by</h2>
        <div class="grid sm:grid-cols-3 gap-3">
          {
            usedBy.map((project) => (
              <a
                class:list={[
                  "flex min-h-20 items-center justify-center rounded-lg border border-stone-700 px-4 text-center transition-colors hover:border-custom-purple",
                  project.logo ? "bg-white" : "bg-custom-dark-gray text-stone-400 hover:text-white",
                ]}
                href={project.href}
              >
                {project.logo ? (
                  <img class="max-h-10 max-w-full" src={project.logo} alt={project.name} loading="lazy" />
                ) : project.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 lg:py-12 border-b border-stone-800/50">
    <div class="max-w-4xl">
      <h2 class="text-xl lg:text-2xl font-bold text-stone-200 mt-2 mb-4">Cross-platform</h2>
      <p class="text-stone-400 text-lg leading-relaxed max-w-2xl">
        Freya brings the same Rust components and rendering model to desktop, mobile, and the browser.
        Platform-specific integrations can be added when your project needs them.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3 mt-8">
        {
          [
            ["Linux", "Desktop"],
            ["Windows", "Desktop"],
            ["macOS", "Desktop"],
            ["Android", "Experimental"],
            ["Web", "Experimental"],
          ].map(([platform, type]) => (
            <div class="rounded-xl border border-stone-700 bg-custom-dark-gray p-4">
              <PlatformIcon name={platform as "Linux" | "Windows" | "macOS" | "Android" | "Web"} />
              <p class="text-white font-semibold mt-3">{platform}</p>
              <p class="text-stone-500 text-sm mt-1">{type}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mt-16 lg:mt-24 divide-y divide-stone-800/50">
    {
      features.map((feature, i) => (
        <FeatureSection
          title={feature.title}
          description={feature.description}
          mediaUrl={feature.mediaUrl}
          mediaType={feature.mediaType}
          reverse={i % 2 !== 0}
          wide={feature.wide}
          actionUrl={feature.actionUrl}
          actionLabel={feature.actionLabel}
        />
      ))
    }
  </div>

  <div class="text-center py-16 lg:py-24 border-t border-stone-800/50">
    <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready to get started?</h2>
    <p class="text-stone-400 text-lg mb-8 max-w-xl mx-auto">
      Build cross-platform, native GUI applications with Rust and Skia.
    </p>
    <div class="flex flex-wrap justify-center gap-2">
      <a
        class="px-6 py-2 bg-sky-500 rounded-lg text-black hover:bg-sky-600 transition-colors delay-[10]"
        href="https://docs.rs/freya/latest/freya/"
        >Get Started</a
      >
      <a
        class="px-6 py-2 bg-orange-300 rounded-lg text-black hover:bg-orange-400 transition-colors delay-[10]"
        href="https://github.com/marc2332/freya">Source Code</a
      >
      <a
        class="px-6 py-2 bg-pink-300 rounded-lg text-black hover:bg-pink-400 transition-colors delay-[10]"
        href="/support">Support</a
      >
    </div>
  </div>
</Layout>

<style>
  video::-internal-media-controls-overlay-cast-button {
    display: none;
  }
</style>
