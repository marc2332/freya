---
import Layout from "../layouts/Layout.astro";
import FreyaDemo from "../components/FreyaDemo.astro";
---

<Layout
    title="Demo - Freya, Rust GUI library"
    description="A Freya app running in your browser, compiled to WebAssembly."
    url="/demo/"
    wide
>
    <h1 class="text-3xl sm:text-4xl font-bold">Demo</h1>
    <p class="mt-2 text-stone-300">
        Freya on WebAssembly.
    </p>

    <FreyaDemo />
</Layout>
