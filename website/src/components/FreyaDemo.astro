---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<div
    id="demo-frame"
    class:list={[
        "relative overflow-hidden bg-white",
        !embedded && "mt-6 mb-12 rounded-xl border border-stone-700",
    ]}
    style={{ height: embedded ? "100dvh" : "min(88vh, 1000px)" }}
>
    <canvas id="canvas" draggable="false"></canvas>
    <div
        id="demo-loading"
        class="absolute inset-0 flex items-center justify-center bg-custom-dark-black text-stone-300"
        role="status"
    >
        Loading the demo...
    </div>
</div>

<style>
    #demo-frame {
        width: 100%;
    }

    #canvas {
        display: block;
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
        user-select: none;
        -webkit-user-select: none;
        -webkit-user-drag: none;
        -webkit-touch-callout: none;
        touch-action: none;
    }
</style>

<script is:inline>
    var Module = {
        canvas: document.getElementById("canvas"),
        onRuntimeInitialized() {
            document.getElementById("demo-loading").remove();
        },
    };
</script>
<script is:inline src="/demo/web_example.js"></script>
