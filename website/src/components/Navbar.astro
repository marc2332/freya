---
import { getCollection } from "astro:content";
import PostDate from "./PostDate.astro";

export interface Props {
  sticky?: boolean;
}

const { sticky = true } = Astro.props;
const threeMonthsAgo = new Date();
threeMonthsAgo.setMonth(threeMonthsAgo.getMonth() - 3);
const latestRecentPost = (await getCollection("blog"))
  .filter((post) => post.data.date >= threeMonthsAgo)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const links = [
  { label: "Blog", href: "/blog/" },
  { label: "Docs", href: "https://docs.rs/freya/latest/freya/" },
  { label: "Source code", href: "https://github.com/marc2332/freya" },
  { label: "Support", href: "/support/" },
  { label: "Discord", href: "https://discord.gg/sYejxCdewG" },
];
---

<header class:list={["site-header bg-custom-dark-black px-4 text-stone-300", sticky && "md:sticky md:top-0 md:z-50"]}>
  <div class="nav-row">
    <a class="brand" aria-label="Freya home" href="/">
      <img src="/logo.svg" width="50" height="50" alt="" />
      <img src="/freya.svg" width="65" alt="Freya" />
    </a>
    <nav class="desktop-links" aria-label="Main navigation">
      {latestRecentPost && (
        <a
          class="hidden xl:flex items-center gap-2 max-w-56 rounded-lg border border-stone-800 bg-custom-dark-black px-3 py-1 text-xs hover:border-custom-purple hover:bg-custom-dark-gray transition-colors"
          href={`/posts/${latestRecentPost.data.slug}/`}
          title={latestRecentPost.data.title}
        >
          <span class="truncate text-white">{latestRecentPost.data.title}</span>
          <PostDate class="shrink-0 text-stone-400" date={latestRecentPost.data.date} />
        </a>
      )}
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    padding-block: 0.75rem;
  }

  .nav-row, .brand {
    display: flex;
    align-items: center;
  }

  .nav-row {
    position: relative;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
  }

  .brand {
    flex-shrink: 0;
    gap: 0.75rem;
  }

  .brand img:first-child {
    width: 40px;
    height: 40px;
  }

  .desktop-links {
    display: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
  }

  .nav-link:hover {
    color: white;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mobile-menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid #29292c;
    border-radius: 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] summary {
    color: white;
    background: #29292c;
  }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    left: 0;
    z-index: 60;
    padding: 0.5rem;
    border: 1px solid #29292c;
    border-radius: 0.75rem;
    background: #18181b;
    box-shadow: 0 12px 24px #0004;
  }

  a:focus-visible, summary:focus-visible {
    outline: 2px solid #c4b5fd;
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .site-header {
      padding-block: 1.5rem;
    }

    .brand img:first-child {
      width: 50px;
      height: 50px;
    }

    .desktop-links {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
